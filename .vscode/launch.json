    "version": "0.2.0",
    "configurations": [

        {
            "name": "Debugpy Old: Remote Attach",
            "type": "debugpy-old",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/app",
                    "remoteRoot": "/app"
                }
            ],
            "justMyCode": true
        }
    ]
}